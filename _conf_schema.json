{
  "judgement_methods": {
    "description": "判断方式",
    "type": "list",
    "options": [
      "规则匹配",
      "LLM判断"
    ],
    "render_type": "checkbox",
    "default": [
      "规则匹配",
      "LLM判断"
    ],
    "hint": "同时启用时先进行规则匹配；规则未命中后才调用类型判断 LLM。"
  },
  "type_judgement_provider": {
    "description": "类型判断 LLM",
    "type": "string",
    "default": "",
    "_special": "select_provider",
    "hint": "选择一个已在 AstrBot 中配置的聊天模型提供商。仅在启用 LLM 判断且规则未命中时调用。"
  },
  "routing_models": {
    "description": "路由模型",
    "type": "template_list",
    "default": [],
    "hint": "按列表顺序匹配；若多个条目同时命中，使用最靠前的可用条目。",
    "templates": {
      "openai_compatible": {
        "name": "OpenAI 兼容",
        "hint": "适用于 OpenAI Chat Completions 兼容接口。",
        "display_item": "name",
        "hide_hint_in_list": true,
        "items": {
          "name": {
            "description": "名称",
            "type": "string",
            "default": "OpenAI 路由模型",
            "hint": "此名称会显示在条目摘要和运行日志中。"
          },
          "enabled": {
            "description": "启用",
            "type": "bool",
            "default": true
          },
          "api_base_url": {
            "description": "API Base URL",
            "type": "string",
            "default": "https://api.openai.com/v1",
            "hint": "可填写到 /v1；插件会自动补充 /chat/completions。也可直接填写完整接口地址。"
          },
          "model": {
            "description": "模型名称",
            "type": "string",
            "default": "gpt-4o-mini",
            "hint": "实际发送给接口的 model 参数。"
          },
          "api_keys": {
            "description": "API Key",
            "type": "list",
            "default": [],
            "hint": "可添加多个 Key，插件会轮换使用，并在鉴权、限流或服务端错误时尝试下一个 Key。无鉴权的本地接口可留空。"
          },
          "content_types": {
            "description": "类型",
            "type": "list",
            "default": [],
            "hint": "用于 LLM 判断，例如：问候、数学问题、哲学、专业性问题。"
          },
          "rule_keywords": {
            "description": "规则词汇",
            "type": "list",
            "default": [],
            "hint": "用于包含匹配，例如：方程、你好、三国。匹配不区分英文大小写。"
          },
          "whitelist": {
            "description": "白名单",
            "type": "list",
            "default": [],
            "hint": "留空不启用。支持直接填写用户/群/会话 ID，或 user:、group:、session:、umo:、name:、platform: 前缀。"
          },
          "blacklist": {
            "description": "黑名单",
            "type": "list",
            "default": [],
            "hint": "留空不启用。格式与白名单相同；黑名单优先级高于白名单。"
          }
        }
      },
      "gemini": {
