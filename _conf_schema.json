{
  "judgement_methods": {
    "description": "判断方式",
    "type": "list",
    "options": [
      "规则匹配",
      "LLM判断"
    ],
    "render_type": "checkbox",
    "default": [
      "规则匹配",
      "LLM判断"
    ],
    "hint": "同时启用时先进行规则匹配；规则未命中后才调用类型判断 LLM。"
  },
  "type_judgement_provider": {
    "description": "类型判断 LLM",
    "type": "string",
    "default": "",
    "_special": "select_provider",
    "hint": "选择一个已在 AstrBot 中配置的聊天模型。仅在启用 LLM 判断且规则未命中时调用。"
  },
  "routing_models": {
    "description": "路由规则",
    "type": "template_list",
    "default": [],
    "hint": "按列表顺序匹配；若多个条目同时命中，使用最靠前的可用条目。",
    "templates": {
      "route": {
        "name": "路由条目",
        "hint": "选择一个 AstrBot 已有聊天模型，并配置该模型的匹配条件。",
        "display_item": "name",
        "hide_hint_in_list": true,
        "items": {
          "name": {
            "description": "名称",
            "type": "string",
            "default": "路由条目",
            "hint": "此名称会显示在条目摘要和运行日志中。"
          },
          "enabled": {
            "description": "启用",
            "type": "bool",
            "default": true
          },
          "route_provider": {
            "description": "路由模型",
            "type": "string",
            "default": "",
            "_special": "select_provider",
            "hint": "选择一个已在 AstrBot 中配置的聊天模型提供商。模型地址、密钥和模型名称均由 AstrBot 统一管理。"
          },
          "content_types": {
            "description": "类型",
            "type": "list",
            "default": [],
            "hint": "用于 LLM 判断，例如：问候、数学问题、哲学、专业性问题。留空则此条目不参与 LLM 判断。"
          },
          "rule_keywords": {
            "description": "规则词汇",
            "type": "list",
            "default": [],
            "hint": "用于包含匹配，例如：方程、你好、三国。匹配不区分英文大小写；留空则此条目不参与规则匹配。"
          },
          "whitelist": {
            "description": "白名单",
            "type": "list",
            "default": [],
            "hint": "留空不启用。支持直接填写用户/群/会话 ID，或 user:、group:、session:、umo:、name:、platform: 前缀。"
          },
          "blacklist": {
            "description": "黑名单",
            "type": "list",
            "default": [],
            "hint": "留空不启用。格式与白名单相同；黑名单优先级高于白名单。"
          }
        }
      }
    }
  }
}
